{
	"schemaVersion": 1,
	"id": "dinosaurs",
	"version": "${version}",
	"name": "Dinosaurs",
	"description": "Adds well-known dinosaurs as new mobs. Each species spawns in its own biomes; carnivores are hostile, herbivores are passive or neutral. Craft an Amulet of Dino Protection from predator drops and a Dinosaur Saddle to ride a Triceratops. English and Polish translations.",
	"authors": [
		"Vasha"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/dinosaurs-mod",
		"sources": "https://github.com/VashaTS/dinosaurs-mod",
		"issues": "https://github.com/VashaTS/dinosaurs-mod/issues"
	},
	"license": "MIT",
	"icon": "assets/dinosaurs/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.vsh33.dinosaurs.Dinosaurs"
		],
		"client": [
			"net.vsh33.dinosaurs.client.DinosaursClient"
		],
		"modmenu": [
			"net.vsh33.dinosaurs.client.compat.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"cloth-config": "*",
		"modmenu": "*",
		"trinkets": "*"
	}
}
